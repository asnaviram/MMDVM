# Test Environment Configuration
# This file contains all required environment variables for running tests
# DO NOT use production values in this file

# ===== SECURITY SETTINGS =====
# JWT Secret for authentication (must be 32+ characters for security)
JWT_SECRET=sMJRViY5CsmsVQKFKWGOwrvGmNCvqaXEiKu+kGYF8wg=
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Bcrypt rounds for password hashing (lower for faster tests)
BCRYPT_ROUNDS=4

# ===== DATABASE SETTINGS =====
# Database type: 'sqlite' or 'postgres'
DB_TYPE=sqlite
# SQLite database file (in-memory for tests)
SQLITE_DB=:memory:
# PostgreSQL settings (if using postgres for tests)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=test_roip
POSTGRES_PASSWORD=test_password
POSTGRES_DB=test_roip_db

# ===== SERVER SETTINGS =====
# Node environment
NODE_ENV=test
# Server port (different from production)
PORT=8888
# SIP port
SIP_PORT=5061
# RTP port range
RTP_PORT_MIN=10000
RTP_PORT_MAX=10100

# ===== SESSION SETTINGS =====
# Session timeout in milliseconds (1 hour)
SESSION_TIMEOUT=3600000
# Session cleanup interval (5 minutes)
SESSION_CLEANUP_INTERVAL=300000

# ===== API SETTINGS =====
# API rate limiting (permissive for tests)
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000

# ===== LOGGING SETTINGS =====
# Log level for tests (error to reduce noise)
LOG_LEVEL=error
# Log file (optional for tests)
LOG_FILE=./logs/test.log

# ===== PERFORMANCE SETTINGS =====
# Max concurrent calls
MAX_CONCURRENT_CALLS=100
# Max participants per call
MAX_PARTICIPANTS_PER_CALL=10
# Call timeout in milliseconds
CALL_TIMEOUT=30000

# ===== AUDIO SETTINGS =====
# Audio codec
AUDIO_CODEC=opus
# Sample rate
SAMPLE_RATE=48000
# Channels
CHANNELS=1
# Bitrate
BITRATE=64000

# ===== TEST-SPECIFIC SETTINGS =====
# Test timeout (milliseconds)
TEST_TIMEOUT=30000
# Skip integration tests that require external services
SKIP_INTEGRATION_TESTS=false
# Skip performance tests
SKIP_PERFORMANCE_TESTS=true
