{
  "name": "esp-roip-server",
  "version": "1.0.0",
  "description": "Lightweight Radio over IP (RoIP) server for ESP32 clients",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/server.js config/production.yaml",
    "start:cluster": "NODE_ENV=production node src/server.js config/production.yaml",
    "dev": "nodemon src/server.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:unit": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=performance.test.js",
    "test:perf": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js test/performance.test.js",
    "test:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --coverageReporters=text --coverageReporters=html",
    "test:ci": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --maxWorkers=2",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:quick": "DURATION=10 CONNECTIONS=50 node scripts/benchmark.js",
    "perf:check": "bash scripts/performance-check.sh",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "docker:build": "docker build -t esp-roip-server .",
    "docker:run": "docker run -p 5060:5060/udp -p 10000-10100:10000-10100/udp -p 8080:8080 esp-roip-server"
  },
  "keywords": [
    "roip",
    "voip",
    "sip",
    "rtp",
    "radio",
    "esp32"
  ],
  "author": "ESP32 RoIP Team",
  "license": "GPL-2.0",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dgram": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "pg": "^8.11.3",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "autocannon": "^8.0.0",
    "babel-jest": "^30.2.0",
    "chai": "^6.2.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
