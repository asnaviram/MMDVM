{
  "name": "esp-roip-server",
  "version": "1.0.0",
  "description": "Lightweight Radio over IP (RoIP) server for ESP32 clients",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/",
    "docker:build": "docker build -t esp-roip-server .",
    "docker:run": "docker run -p 5060:5060/udp -p 10000-10100:10000-10100/udp -p 8080:8080 esp-roip-server"
  },
  "keywords": [
    "roip",
    "voip",
    "sip",
    "rtp",
    "radio",
    "esp32"
  ],
  "author": "ESP32 RoIP Team",
  "license": "GPL-2.0",
  "dependencies": {
    "express": "^4.18.2",
    "yaml": "^2.3.4",
    "ws": "^8.14.2",
    "pg": "^8.11.3",
    "better-sqlite3": "^9.0.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "dgram": "^1.0.1",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
