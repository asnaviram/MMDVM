# ESP32 RoIP Server - Docker Environment Configuration
# Copy this file to .env and customize for your deployment

# ========================================
# General Server Configuration
# ========================================
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# ========================================
# SIP Configuration
# ========================================
SIP_TRANSPORT=udp
SIP_REALM=roip.local

# ========================================
# API Configuration
# ========================================
# CORS origins for REST API (use specific domains in production)
API_CORS_ORIGINS=*

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
# Database name
DB_NAME=roip

# Database user
DB_USER=roip

# Database password (REQUIRED IN PRODUCTION!)
# Generate a secure password: openssl rand -base64 24
# NEVER use the default value in production
DB_PASSWORD=CHANGE-THIS-PASSWORD-IMMEDIATELY

# Database pool size (connections)
DB_POOL_SIZE=20

# ========================================
# Authentication & Security
# ========================================
# JWT secret for API authentication (REQUIRED IN PRODUCTION!)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The server will reject insecure default values
JWT_SECRET=CHANGE-THIS-SECRET-IMMEDIATELY

# JWT token expiry time
JWT_EXPIRY=1h

# ========================================
# TURN/STUN Server Configuration
# ========================================
# TURN server hostname/IP
TURN_SERVER=coturn

# TURN server port
TURN_PORT=3478

# TURN authentication username
TURN_USERNAME=roip

# TURN authentication password (CHANGE THIS IN PRODUCTION!)
TURN_PASSWORD=roip_turn_password

# Enable STUN functionality
ENABLE_STUN=true

# Enable TURN functionality
ENABLE_TURN=true

# Enable NAT detection
NAT_DETECTION=true

# ========================================
# Deployment & Networking
# ========================================
# External IP address (for TURN server detection)
# Leave empty for automatic detection
EXTERNAL_IP=

# External hostname (for client access)
# Leave empty if using IP address
EXTERNAL_HOSTNAME=

# ========================================
# Performance Tuning
# ========================================
# Maximum concurrent calls
MAX_CONCURRENT_CALLS=100

# Call timeout (seconds)
CALL_TIMEOUT=3600

# RTP buffer size (bytes)
RTP_BUFFER_SIZE=65536

# ========================================
# Backup & Persistence
# ========================================
# Enable automatic backups
ENABLE_BACKUPS=true

# Backup interval (hours)
BACKUP_INTERVAL=24

# Backup retention (days)
BACKUP_RETENTION=7

# ========================================
# Monitoring & Alerts
# ========================================
# Enable Prometheus metrics
ENABLE_METRICS=true

# Metrics port
METRICS_PORT=9090

# Enable health checks
ENABLE_HEALTH_CHECKS=true

# ========================================
# Advanced Configuration
# ========================================
# Certificate paths (for TLS)
# Leave empty to disable TLS
TLS_CERT_PATH=
TLS_KEY_PATH=

# Proxy configuration (if behind NAT)
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=

# Custom YAML config file (optional)
# CONFIG_FILE=/app/config/custom.yaml
