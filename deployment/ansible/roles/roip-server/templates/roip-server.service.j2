[Unit]
Description=RoIP Server - Radio over IP Gateway
Documentation=https://github.com/yourorg/roip-server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_home }}/server
EnvironmentFile={{ app_home }}/server/.env

ExecStart=/usr/bin/node src/server.js
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ app_home }}/logs {{ app_home }}/data

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=roip-server

[Install]
WantedBy=multi-user.target
