# RoIP Server Environment Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Environment
NODE_ENV={{ environment }}

# Server Configuration
SERVER_HOST=0.0.0.0
SIP_PORT={{ roip_sip_port }}
SIP_TRANSPORT=udp
SIP_REALM={{ turn_realm }}
RTP_PORT_MIN={{ roip_rtp_port_min }}
RTP_PORT_MAX={{ roip_rtp_port_max }}

# API Configuration
API_PORT={{ roip_api_port }}
WEBSOCKET_PORT={{ roip_websocket_port }}
API_CORS_ORIGINS={{ api_cors_origins | default('*') }}

# Database Configuration
DB_TYPE=postgresql
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_POOL_SIZE={{ db_pool_size }}

# Authentication
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRY={{ jwt_expiry | default('1h') }}

# Logging
LOG_LEVEL={{ log_level | default('info') }}
LOG_FORMAT={{ log_format | default('json') }}
LOG_DIR={{ app_home }}/logs

# TURN/STUN Configuration
TURN_SERVER={{ turn_server_host }}
TURN_PORT={{ turn_port }}
TURN_USERNAME={{ turn_username }}
TURN_PASSWORD={{ turn_password }}
ENABLE_STUN=true
ENABLE_TURN=true
NAT_DETECTION=true

# Performance
CLUSTER_MODE={{ cluster_mode | default('false') }}
CLUSTER_WORKERS={{ cluster_workers | default(4) }}

# Monitoring
ENABLE_METRICS={{ enable_metrics | default('true') }}
METRICS_PORT={{ metrics_port | default(9090) }}
