# Coturn TURN/STUN Server Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Listening ports
listening-port={{ turn_port }}
tls-listening-port=5349

# Listening IPs
listening-ip={{ ansible_default_ipv4.address }}
{% if ansible_default_ipv6.address is defined %}
listening-ip={{ ansible_default_ipv6.address }}
{% endif %}

# Relay IPs
relay-ip={{ ansible_default_ipv4.address }}
{% if ansible_default_ipv6.address is defined %}
relay-ip={{ ansible_default_ipv6.address }}
{% endif %}

# External IP (for NAT)
{% if turn_external_ip is defined %}
external-ip={{ turn_external_ip }}
{% else %}
# external-ip=<your-public-ip>
{% endif %}

# Relay ports
min-port=49152
max-port=65535

# Authentication
lt-cred-mech
realm={{ turn_realm }}
userdb=/etc/turnusers.txt

# Security
fingerprint
no-multicast-peers
no-cli
no-loopback-peers
no-tcp-relay

# Performance
max-bps=1000000
bps-capacity=0
stale-nonce=600

# Logging
{% if environment == 'production' %}
log-file=/var/log/turnserver/turnserver.log
syslog
{% else %}
verbose
{% endif %}

# SSL/TLS
{% if enable_ssl and ssl_cert_path is defined %}
cert={{ ssl_cert_path }}
pkey={{ ssl_key_path }}
{% else %}
# SSL disabled or certificates not configured
{% endif %}

# Misc
no-stdout-log
simple-log
