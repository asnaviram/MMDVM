# RoIP Production Inventory
# Edit this file with your production server details

[all_in_one]
roip-prod-01 ansible_host=10.0.1.10 ansible_user=ubuntu

[app_servers]
# roip-app-01 ansible_host=10.0.1.20
# roip-app-02 ansible_host=10.0.1.21

[database]
# roip-db-01 ansible_host=10.0.1.30

[turn_servers]
# roip-turn-01 ansible_host=10.0.1.40

[web_servers]
# roip-web-01 ansible_host=10.0.1.50

[monitoring]
# roip-monitor-01 ansible_host=10.0.1.60

[production:children]
all_in_one
app_servers
database
turn_servers
web_servers

[production:vars]
# Environment
environment=production
system_timezone=UTC

# Application
app_version=latest
app_user=roip
app_group=roip
app_home=/opt/roip-server

# Node.js
nodejs_version=18

# Database
db_name=roip_production
db_user=roip_user
db_password=CHANGE_THIS_PASSWORD
db_host=localhost
db_port=5432
db_pool_size=20

# RoIP Server
roip_sip_port=5060
roip_rtp_port_min=10000
roip_rtp_port_max=10100
roip_api_port=8080
roip_websocket_port=8081

# Security
jwt_secret=CHANGE_THIS_SECRET
enable_ssl=true
ssl_cert_email=admin@example.com

# TURN/STUN
turn_server_host={{ ansible_default_ipv4.address }}
turn_port=3478
turn_username=roip
turn_password=CHANGE_THIS_PASSWORD
turn_realm=roip.local

# Monitoring
deploy_monitoring=false
prometheus_retention=15d
grafana_admin_password=CHANGE_THIS_PASSWORD

# Backup
backup_enabled=true
backup_retention_days=30
backup_s3_bucket=roip-backups

# SSL
domain_name=roip.example.com
letsencrypt_email=admin@example.com
