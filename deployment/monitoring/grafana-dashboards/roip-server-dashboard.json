{
  "dashboard": {
    "title": "RoIP Server Dashboard",
    "tags": ["roip", "voip", "server"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "Active Calls",
        "type": "graph",
        "targets": [
          {
            "expr": "roip_active_calls_total",
            "legendFormat": "Active Calls"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Registered Devices",
        "type": "stat",
        "targets": [
          {
            "expr": "roip_registered_devices_total",
            "legendFormat": "Registered"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Call Success Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(roip_calls_total[5m]) - rate(roip_calls_failed_total[5m])",
            "legendFormat": "Successful Calls/s"
          },
          {
            "expr": "rate(roip_calls_failed_total[5m])",
            "legendFormat": "Failed Calls/s"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "API Response Time (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "RTP Packet Loss",
        "type": "graph",
        "targets": [
          {
            "expr": "roip_rtp_packet_loss_percent",
            "legendFormat": "Packet Loss %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "{{instance}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 7,
        "title": "Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "Memory Used %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "Network Throughput",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total[5m]) * 8 / 1000000",
            "legendFormat": "RX Mbps"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total[5m]) * 8 / 1000000",
            "legendFormat": "TX Mbps"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
